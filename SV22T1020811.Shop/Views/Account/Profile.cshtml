@model SV22T1020811.Models.Partner.Customer
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<main class="pt-28 pb-20 px-6 max-w-7xl mx-auto min-h-screen font-sans">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">

        <aside class="md:col-span-3">
            @await Html.PartialAsync("_SidebarProfile")
        </aside>

        <div class="md:col-span-9 space-y-6">
            <div class="bg-white rounded-[32px] border border-slate-100 shadow-sm overflow-hidden">

                <form action="~/Account/UpdateProfile" method="post">
                    <input type="hidden" name="CustomerID" value="@Model.CustomerID" />

                    <div class="p-8 border-b border-slate-50 flex items-center justify-between">
                        <div>
                            <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tight">Hồ sơ cá nhân</h2>
                            <p class="text-slate-400 text-sm mt-1">Quản lý thông tin hồ sơ để bảo mật tài khoản</p>
                        </div>
                        <button type="submit" class="bg-[#00497d] text-white px-10 py-3 rounded-2xl font-bold text-sm hover:shadow-lg hover:shadow-blue-100 transition-all">
                            Lưu thay đổi
                        </button>
                    </div>

                    <div class="p-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

                            <div class="space-y-2">
                                <label class="text-xs font-black text-slate-400 uppercase ml-2">Họ và tên khách hàng</label>
                                <input type="text" name="CustomerName" value="@Model.CustomerName" required
                                       class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-[#00497d] transition-all font-bold text-slate-700">
                            </div>

                            <div class="space-y-2">
                                <label class="text-xs font-black text-slate-400 uppercase ml-2">Địa chỉ Email</label>
                                <input type="email" name="Email" value="@Model.Email" readonly
                                       class="w-full px-5 py-4 bg-slate-200 border-none rounded-2xl cursor-not-allowed font-medium text-slate-500">
                            </div>

                            <div class="space-y-2">
                                <label class="text-xs font-black text-slate-400 uppercase ml-2">Số điện thoại</label>
                                <input type="text" name="Phone" value="@Model.Phone" placeholder="Nhập số điện thoại..."
                                       class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-[#00497d] transition-all font-medium text-slate-700">
                            </div>

                            <div class="space-y-2">
                                <label class="text-xs font-black text-slate-400 uppercase ml-2">Tên giao dịch (Contact Name)</label>
                                <input type="text" name="ContactName" value="@Model.ContactName"
                                       class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-[#00497d] transition-all font-medium text-slate-700">
                            </div>

                            <div class="space-y-2">
                                <label class="text-xs font-black text-slate-400 uppercase ml-2">Tỉnh / Thành phố</label>
                                <select name="Province" class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-[#00497d] transition-all font-medium text-slate-700">
                                    <option value="">-- Chọn Tỉnh/Thành --</option>
                                    @if (ViewBag.Provinces != null)
                                    {
                                        foreach (var p in (List<SV22T1020811.Models.DataDictionary.Province>)ViewBag.Provinces)
                                        {
                                            <option value="@p.ProvinceName" selected="@(p.ProvinceName == Model.Province)">
                                                @p.ProvinceName
                                            </option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="md:col-span-2 space-y-2">
                                <label class="text-xs font-black text-slate-400 uppercase ml-2">Địa chỉ nhận hàng mặc định</label>
                                <textarea name="Address" rows="3"
                                          class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-[#00497d] transition-all font-medium text-slate-700">@Model.Address</textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-blue-50 p-6 rounded-[24px] border border-blue-100 flex items-start gap-4">
                    <span class="material-symbols-outlined text-blue-600 bg-white p-3 rounded-2xl shadow-sm">verified_user</span>
                    <div>
                        <h4 class="font-bold text-blue-900">Bảo mật tài khoản</h4>
                        <p class="text-xs text-blue-600/80 mt-1">Đức nên thường xuyên thay đổi mật khẩu để đảm bảo an toàn.</p>
                        <a href="~/Account/ChangePassword" class="text-xs font-black text-blue-700 underline mt-2 inline-block uppercase tracking-wider">Đổi mật khẩu ngay</a>
                    </div>
                </div>

                <div class="bg-slate-900 p-6 rounded-[24px] flex items-start gap-4">
                    <span class="material-symbols-outlined text-yellow-400 p-3">workspace_premium</span>
                    <div>
                        <h4 class="font-bold text-white">Thành viên thân thiết</h4>
                        <p class="text-xs text-slate-400 mt-1">Cảm ơn Đức đã đồng hành cùng DUC.Shop trong suốt thời gian qua.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>