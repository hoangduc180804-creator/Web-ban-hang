@model SV22T1020811.Shop.Models.ChangePasswordInput
@{
    ViewData["Title"] = "Đổi mật khẩu";
    // Lấy tên Action hiện tại để check Active cho Sidebar
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<main class="pt-28 pb-20 px-6 max-w-7xl mx-auto min-h-screen font-sans">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">

        <aside class="md:col-span-3">
            <div class="bg-white rounded-[32px] border border-slate-100 shadow-sm p-4 space-y-2 sticky top-28">
                <div class="px-4 py-3 mb-2 text-center border-b border-slate-50">
                    <div class="w-16 h-16 mx-auto mb-3 rounded-full signature-gradient flex items-center justify-center text-white text-xl font-black shadow-lg border-4 border-white">
                        @User.Identity.Name?.Substring(0, 1).ToUpper()
                    </div>
                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Xin chào!</p>
                    <p class="text-sm font-black text-[#00497d] truncate">@User.Identity.Name</p>
                </div>

                <a href="~/Account/Profile" class="flex items-center gap-3 px-4 py-4 rounded-2xl transition-all @(currentAction == "Profile" ? "bg-[#00497d] text-white shadow-xl shadow-blue-100" : "hover:bg-slate-50 text-slate-600")">
                    <span class="material-symbols-outlined text-[20px]">person</span>
                    <span class="text-sm font-bold">Thông tin cá nhân</span>
                </a>

                <a href="~/Order/History" class="flex items-center gap-3 px-4 py-4 rounded-2xl transition-all @(currentAction == "History" ? "bg-[#00497d] text-white shadow-xl shadow-blue-100" : "hover:bg-slate-50 text-slate-600")">
                    <span class="material-symbols-outlined text-[20px]">package_2</span>
                    <span class="text-sm font-bold">Lịch sử đơn hàng</span>
                </a>

                <a href="~/Account/ChangePassword" class="flex items-center gap-3 px-4 py-4 rounded-2xl transition-all @(currentAction == "ChangePassword" ? "bg-[#00497d] text-white shadow-xl shadow-blue-100" : "hover:bg-slate-50 text-slate-600")">
                    <span class="material-symbols-outlined text-[20px]">lock</span>
                    <span class="text-sm font-bold">Đổi mật khẩu</span>
                </a>

                <div class="pt-4 mt-2 border-t border-slate-50">
                    <a href="~/Account/Logout" class="flex items-center gap-3 px-4 py-4 rounded-2xl hover:bg-red-50 text-red-500 transition-all">
                        <span class="material-symbols-outlined text-[20px]">logout</span>
                        <span class="text-sm font-bold">Đăng xuất</span>
                    </a>
                </div>
            </div>
        </aside>

        <div class="md:col-span-9 space-y-6">
            <div class="bg-white rounded-[32px] border border-slate-100 shadow-sm overflow-hidden font-sans">

                <form asp-action="ChangePassword" method="post">
                    @* Header Card *@
                    <div class="p-8 border-b border-slate-50 flex items-center justify-between">
                        <div>
                            <h2 class="text-2xl font-black text-slate-900 uppercase tracking-tight italic">Đổi <span class="text-[#00497d]">mật khẩu</span></h2>
                            <p class="text-slate-400 text-sm mt-1 font-medium">Bảo mật tài khoản bằng mật khẩu mạnh</p>
                        </div>
                        <button type="submit" class="bg-[#00497d] text-white px-10 py-3 rounded-2xl font-bold text-sm hover:shadow-lg hover:shadow-blue-100 transition-all hover:scale-[1.02] active:scale-95">
                            Cập nhật ngay
                        </button>
                    </div>

                    @* Body Form *@
                    <div class="p-8">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="mb-6 p-4 bg-red-50 text-red-600 rounded-2xl text-[11px] font-bold border border-red-100 animate-pulse">
                                @Html.ValidationSummary(true, "")
                            </div>
                        }

                        <div class="max-w-md space-y-6">
                            <div class="space-y-2">
                                <label class="text-[11px] font-black text-slate-400 uppercase ml-2 tracking-widest">Mật khẩu hiện tại</label>
                                <input type="password" asp-for="OldPassword" required
                                       class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-[#00497d] transition-all font-bold text-slate-700 outline-none placeholder:font-normal"
                                       placeholder="••••••••">
                            </div>

                            <div class="space-y-2">
                                <label class="text-[11px] font-black text-slate-400 uppercase ml-2 tracking-widest">Mật khẩu mới</label>
                                <input type="password" asp-for="NewPassword" required
                                       class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-[#00497d] transition-all font-bold text-slate-700 outline-none placeholder:font-normal"
                                       placeholder="Nhập mật khẩu mới">
                            </div>

                            <div class="space-y-2">
                                <label class="text-[11px] font-black text-slate-400 uppercase ml-2 tracking-widest">Xác nhận mật khẩu</label>
                                <input type="password" asp-for="ConfirmPassword" required
                                       class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl focus:ring-2 focus:ring-[#00497d] transition-all font-bold text-slate-700 outline-none placeholder:font-normal"
                                       placeholder="Nhập lại mật khẩu mới">
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>