@model SV22T1020811.Shop.Models.RegisterViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng ký tài khoản";
}

<main class="flex-grow flex items-center justify-center py-12 px-4 md:px-8">
    <div class="max-w-6xl w-full flex flex-col md:flex-row-reverse h-full md:min-h-[700px] overflow-hidden rounded-3xl bg-white shadow-xl border border-slate-100">

        <div class="hidden md:flex relative w-1/2 overflow-hidden">
            <img alt="Register" class="absolute inset-0 w-full h-full object-cover"
                 src="~/images/backgrou.jpg" />
            <div class="absolute inset-0 bg-primary/20 backdrop-brightness-75 flex flex-col justify-end p-12">
                <div class="glass-panel p-8 rounded-2xl border border-white/20 text-white">
                    <h1 class="font-headline text-3xl font-extrabold mb-4 tracking-tight">DUC.Shop</h1>
                    <p class="text-white/90 text-lg leading-relaxed font-medium">
                        Tham gia cùng DUC.Shop để trải nghiệm hệ thống mua sắm hiện đại nhất.
                    </p>
                </div>
            </div>
        </div>

        <div class="w-full md:w-1/2 flex flex-col justify-center items-center p-8 md:p-12 bg-white">
            <div class="w-full max-w-sm">
                <div class="mb-8 space-y-2 text-center md:text-left">
                    <h2 class="font-headline text-3xl font-extrabold text-slate-900 tracking-tight">Tạo tài khoản</h2>
                    <p class="text-slate-500 text-sm">Điền thông tin bên dưới để bắt đầu mua sắm.</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="p-4 mb-4 rounded-xl bg-red-50 border border-red-100 text-red-600 text-xs font-medium">
                            @Html.ValidationSummary(false, "")
                        </div>
                    }

                    <div class="space-y-1.5">
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-1">Họ và tên khách hàng</label>
                        <input asp-for="CustomerName" type="text"
                               class="w-full h-12 bg-slate-50 border-none rounded-xl px-4 text-slate-900 focus:ring-2 focus:ring-primary transition-all"
                               placeholder="VD: Nguyễn Văn A" required />
                        <span asp-validation-for="CustomerName" class="text-red-500 text-[10px] px-1 block mt-1"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-1">Email đăng nhập</label>
                        <input asp-for="Email" type="email"
                               class="w-full h-12 bg-slate-50 border-none rounded-xl px-4 text-slate-900 focus:ring-2 focus:ring-primary transition-all"
                               placeholder="name@example.com" required />
                        <span asp-validation-for="Email" class="text-red-500 text-[10px] px-1 block mt-1"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-1">Mật khẩu</label>
                        <div class="relative">
                            <input asp-for="Password" type="password" id="password"
                                   class="w-full h-12 bg-slate-50 border-none rounded-xl px-4 pr-12 text-slate-900 focus:ring-2 focus:ring-primary transition-all"
                                   placeholder="......" required />
                            <button type="button" onclick="togglePassword()"
                                    class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 hover:text-primary transition-colors focus:outline-none">
                                <span id="eye-icon" class="material-symbols-outlined text-xl">visibility</span>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-[10px] px-1 block mt-1"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-[10px] font-bold uppercase tracking-wider text-slate-400 px-1">Xác nhận mật khẩu</label>
                        <input asp-for="ConfirmPassword" type="password"
                               class="w-full h-12 bg-slate-50 border-none rounded-xl px-4 text-slate-900 focus:ring-2 focus:ring-primary transition-all"
                               placeholder="......" required />
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-[10px] px-1 block mt-1"></span>
                    </div>

                    <button class="w-full h-14 signature-gradient text-white font-bold rounded-full shadow-lg shadow-blue-200 mt-6 active:scale-95 transition-all hover:brightness-110"
                            type="submit">
                        Đăng Ký Ngay
                    </button>
                </form>

                <div class="mt-8 text-center">
                    <p class="text-sm text-slate-500 font-medium">
                        Đã có tài khoản?
                        <a asp-action="Login" class="text-primary font-bold hover:underline ml-1">Đăng nhập ngay</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function togglePassword() {
            const input = document.getElementById('password');
            const icon = document.getElementById('eye-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                input.type = 'password';
                icon.textContent = 'visibility';
            }
        }
    </script>
}