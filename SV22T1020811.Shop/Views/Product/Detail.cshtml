@model SV22T1020811.Models.Catalog.Product
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.ProductName;

    ViewData["MetaDescription"] = string.IsNullOrEmpty(Model.ProductDescription) ? "Chi tiết sản phẩm " + Model.ProductName : Model.ProductDescription;
    ViewData["OgImage"] = string.IsNullOrEmpty(Model.Photo) ? "/images/no-image.png" : "/images/products/" + Model.Photo;

    var photos = ViewBag.Photos as List<SV22T1020811.Models.Catalog.ProductPhoto>;
    var attributes = ViewBag.Attributes as List<SV22T1020811.Models.Catalog.ProductAttribute>;
}

<main class="pt-28 pb-20 px-4 md:px-8 max-w-[1600px] mx-auto">
    <nav class="mb-10 flex items-center space-x-2 text-sm font-medium text-slate-400">
        <a class="hover:text-[#00497d] transition-colors" href="@Url.Action("Index", "Home")">Trang chủ</a>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-slate-800 font-bold">Chi tiết sản phẩm</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-20">
        <div class="lg:col-span-7 space-y-6">
            @* CHỈNH SỬA: Ảnh chính cố định aspect-ratio và dùng object-cover *@
            <div class="relative rounded-3xl overflow-hidden bg-slate-50 border border-slate-100 aspect-[4/3] shadow-sm">
                <img id="mainImage"
                     class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                     src="@(string.IsNullOrEmpty(Model.Photo) ? "/images/no-image.png" : "/images/products/" + Model.Photo)"
                     onerror="this.src='/images/no-image.png';"
                     alt="@Model.ProductName" />

                @if (Model.IsSelling)
                {
                    <div class="absolute top-6 left-6 signature-gradient text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-lg">
                        Đang kinh doanh
                    </div>
                }
                else
                {
                    <div class="absolute top-6 left-6 bg-slate-500 text-white px-4 py-1.5 rounded-full text-[10px] font-bold tracking-widest uppercase shadow-lg">
                        Ngừng kinh doanh
                    </div>
                }
            </div>

            @if (photos != null && photos.Count > 0)
            {
                <div class="grid grid-cols-4 gap-4">
                    @foreach (var p in photos)
                    {
                        @* CHỈNH SỬA: Gallery con dùng aspect-square (hình vuông) và object-cover *@
                        <div class="aspect-square rounded-xl overflow-hidden border-2 border-transparent hover:border-[#00497d]/50 transition-all cursor-pointer thumbnail-container">
                            <img src="/images/products/@p.Photo"
                                 class="thumbnail-img w-full h-full object-cover"
                                 onclick="selectThumbnail(this, '/images/products/@p.Photo')"
                                 onerror="this.src='/images/no-image.png';" />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="lg:col-span-5 flex flex-col justify-center">
            @* Các phần thông tin ProductName, Price... giữ nguyên như code cũ *@
            <div class="mb-3 uppercase tracking-[0.2em] text-[10px] font-black text-[#00497d]/60">
                Mã hàng: @Model.ProductID
            </div>

            <h1 class="text-4xl md:text-5xl font-extrabold font-headline text-slate-900 mb-4 leading-tight">
                @Model.ProductName
            </h1>

            <div class="flex items-center gap-4 mb-8">
                <span class="text-4xl font-black text-[#00497d]">@Model.Price.ToString("N0") <span class="text-lg underline">đ</span></span>
                <span class="text-slate-400 text-sm">/ @Model.Unit</span>
            </div>

            <div class="prose prose-slate max-w-none mb-10">
                <p class="text-slate-500 leading-relaxed text-lg border-l-4 border-[#00497d]/20 pl-6 italic">
                    @(string.IsNullOrEmpty(Model.ProductDescription) ? "Thông tin sản phẩm đang được cập nhật..." : Model.ProductDescription)
                </p>
            </div>

            @* Form Add to Cart giữ nguyên *@
            <form id="addToCartForm" action="@Url.Action("AddToCart", "Cart")" method="post" class="space-y-6">
                <input type="hidden" name="ProductID" value="@Model.ProductID" />

                <div class="flex flex-col sm:flex-row gap-4 items-end">
                    <div class="w-full sm:w-32">
                        <label class="block text-[10px] font-black text-slate-400 mb-3 uppercase tracking-widest px-1">Số lượng</label>
                        <div class="flex items-center h-14 bg-slate-50 border border-slate-100 rounded-2xl px-4 justify-between">
                            <button type="button" onclick="changeQty(-1)" class="p-2 hover:text-[#00497d] transition-colors focus:outline-none shrink-0">
                                <span class="material-symbols-outlined">remove</span>
                            </button>

                            <input type="number" id="quantity" name="quantity" value="1" min="1"
                                   oninput="if(this.value < 1) this.value = 1;"
                                   class="w-full text-center bg-transparent border-none font-bold focus:ring-0 m-0 p-0"
                                   style="-moz-appearance: textfield; appearance: textfield; min-width: 30px;" />

                            <button type="button" onclick="changeQty(1)" class="p-2 hover:text-[#00497d] transition-colors focus:outline-none shrink-0">
                                <span class="material-symbols-outlined">add</span>
                            </button>
                        </div>
                    </div>

                    <style>
                        /* Chặn tuyệt đối hiện mũi tên làm lệch số trên Chrome/Edge/Safari */
                        #quantity::-webkit-outer-spin-button,
                        #quantity::-webkit-inner-spin-button {
                            -webkit-appearance: none;
                            margin: 0;
                        }
                    </style>

                    @if (Model.IsSelling)
                    {
                        <button type="submit" class="flex-grow h-14 signature-gradient text-white rounded-2xl font-bold text-lg active:scale-[0.97] transition-all flex items-center justify-center gap-3 shadow-xl shadow-blue-200">
                            <span class="material-symbols-outlined">shopping_bag</span>
                            Thêm vào giỏ hàng
                        </button>
                    }
                    else
                    {
                        <button type="button" class="flex-grow h-14 bg-slate-200 text-slate-400 rounded-2xl font-bold text-lg cursor-not-allowed flex items-center justify-center gap-3" disabled>
                            <span class="material-symbols-outlined">block</span>
                            Ngừng kinh doanh
                        </button>
                    }
                </div>
            </form>

            @* Toast Success & Attributes Area giữ nguyên *@
            <div id="toast-success" class="fixed bottom-5 right-5 bg-emerald-500 text-white px-6 py-3 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300 translate-y-20 opacity-0 z-50">
                <span class="material-symbols-outlined">check_circle</span>
                <span class="font-bold">Đã thêm vào giỏ hàng!</span>
            </div>

            <div class="mt-12 pt-8 border-t border-slate-100">
                <h3 class="text-sm font-black uppercase tracking-widest text-slate-400 mb-6">Thông số chi tiết</h3>
                <div class="grid grid-cols-1 gap-4">
                    @if (attributes != null && attributes.Count > 0)
                    {
                        @foreach (var attr in attributes)
                        {
                            <div class="flex items-center justify-between py-3 border-b border-slate-50">
                                <span class="text-sm text-slate-500">@attr.AttributeName</span>
                                <span class="text-sm font-bold text-slate-800">@attr.AttributeValue</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
                function changeQty(amt) {
            const qtyInput = document.getElementById('quantity');
            let val = parseInt(qtyInput.value) || 1; // Đảm bảo luôn có số

            val += amt;

            // Chặn không cho nhỏ hơn 1
            if (val < 1) {
                val = 1;
                // Thêm hiệu ứng rung nhẹ để báo hiệu cho người dùng (tùy chọn)
                qtyInput.parentElement.classList.add('animate-pulse', 'border-red-300');
                setTimeout(() => {
                    qtyInput.parentElement.classList.remove('animate-pulse', 'border-red-300');
                }, 500);
            }

            // Giới hạn tối đa (ví dụ 999)
            if (val > 999) val = 999;

            qtyInput.value = val;
        }

        function selectThumbnail(element, imageSrc) {
            document.getElementById('mainImage').src = imageSrc;

            // Highlight container của thumbnail
            document.querySelectorAll('.thumbnail-container').forEach(container => {
                container.classList.remove('border-[#00497d]', 'shadow-md');
                container.classList.add('border-transparent');
            });

            const container = element.parentElement;
            container.classList.remove('border-transparent');
            container.classList.add('border-[#00497d]', 'shadow-md');
        }

        // Kích hoạt thumbnail đầu tiên khi load trang
        document.addEventListener("DOMContentLoaded", function() {
            const firstThumb = document.querySelector('.thumbnail-img');
            if(firstThumb) firstThumb.click();
        });

        // AJAX Add to Cart
        $("#addToCartForm").on("submit", function(e) {
            e.preventDefault();
            var form = $(this);
            $.ajax({
                type: "POST",
                url: form.attr('action'),
                data: form.serialize(),
                success: function() {
                    const toast = document.getElementById('toast-success');
                    toast.classList.replace('translate-y-20', 'translate-y-0');
                    toast.classList.replace('opacity-0', 'opacity-100');
                    setTimeout(() => {
                        toast.classList.replace('translate-y-0', 'translate-y-20');
                        toast.classList.replace('opacity-100', 'opacity-0');
                    }, 2500);
                }
            });
        });
    </script>
}