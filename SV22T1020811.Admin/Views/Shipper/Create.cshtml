<div class="card card-primary mt-3">
    <div class="card-header"><h3 class="card-title">@ViewBag.Title</h3></div>
    <form action="~/Shipper/Save" method="post">
        <div class="card-body">
            <div class="form-group mb-3">
                <label class="fw-bold">Tên người giao hàng:</label>
                <input type="text" class="form-control" name="ShipperName" autofocus placeholder="Ví dụ: Giao hàng nhanh">
            </div>
            <div class="form-group mb-3">
                <label class="fw-bold">Số điện thoại:</label>
                <input type="text" class="form-control" name="Phone" placeholder="Số điện thoại liên hệ">
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Lưu dữ liệu</button>
            <a href="~/Shipper" class="btn btn-default">Quay lại</a>
        </div>
    </form>
</div>