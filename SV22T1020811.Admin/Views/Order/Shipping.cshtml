@using SV22T1020811.Models.Common
@model int
@{
    Layout = null;
    // Lấy danh sách từ ViewBag đã được Controller chuẩn bị
    var shippers = ViewBag.Shippers as List<Shipper> ?? new List<Shipper>();
}

<div class="modal-header text-bg-info">
    <strong class="modal-title">
        <i class="bi bi-truck me-2"></i>Chọn người giao hàng
    </strong>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    @* Form gửi dữ liệu về Action Shipping với phương thức POST *@
    <form id="formShipping" action="~/Order/Shipping/@Model" method="post">
        <div class="row">
            <div class="col-12">
                <label class="form-label fw-bold">Người giao hàng</label>
                <select class="form-select" name="shipperID" required>
                    <option value="">-- Chọn người giao hàng ---</option>
                    @foreach (var s in shippers)
                    {
                        <option value="@s.ShipperID">@s.ShipperName (@s.Phone)</option>
                    }
                </select>
            </div>
        </div>
    </form>
</div>

<div class="modal-footer">
    @* Thuộc tính form="formShipping" giúp nút submit này điều khiển được form ở trên *@
    <button type="submit" form="formShipping" class="btn btn-primary">
        <i class="bi bi-bicycle me-1"></i> Giao hàng
    </button>
    <button type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">
        Đóng
    </button>
</div>