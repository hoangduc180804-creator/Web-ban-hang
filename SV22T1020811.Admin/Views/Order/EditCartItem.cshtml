@model dynamic
@{
    Layout = null;

    // Kiểm tra xem đây là Đơn hàng trong DB hay Giỏ hàng trong Session
    bool isOrderDetail = false;
    try
    {
        // Nếu có thuộc tính OrderID và nó khác 0 thì là Đơn hàng trong DB
        isOrderDetail = Model.OrderID > 0;
    }
    catch { }

    // Xác định Action để gửi dữ liệu
    string actionUrl = isOrderDetail ? "~/Order/UpdateDetail" : "~/Order/AddToCart";
    string formId = isOrderDetail ? "formUpdateOrderDetail" : "formUpdateCartItem";
}

<div class="modal-header">
    <strong class="modal-title">
        <i class="bi bi-pencil-square"></i> Cập nhật chi tiết đơn hàng
    </strong>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <form id="@formId" action="@Url.Content(actionUrl)" method="post" class="container-fluid" onsubmit="return false;">
        @* Các hidden input để giữ thông tin định danh *@
        @if (isOrderDetail)
        {
            <input type="hidden" name="OrderID" value="@Model.OrderID" />
        }
        <input type="hidden" name="ProductID" value="@Model.ProductID" />
        <input type="hidden" name="ProductName" value="@Model.ProductName" />
        <input type="hidden" name="Unit" value="@Model.Unit" />
        <input type="hidden" name="Photo" value="@Model.Photo" />

        <div class="row">
            <div class="col-md-8">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 col-form-label fw-semibold">Mặt hàng</label>
                    <div class="col-sm-8">
                        <input type="text"
                               class="form-control-plaintext fw-bold text-primary"
                               value="@Model.ProductName"
                               readonly>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 col-form-label fw-semibold">Số lượng</label>
                    <div class="col-sm-5">
                        <input type="number"
                               name="Quantity"
                               class="form-control text-end"
                               min="1"
                               value="@Model.Quantity">
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 col-form-label fw-semibold">Đơn giá</label>
                    <div class="col-sm-5">
                        <input type="text"
                               name="SalePrice"
                               class="form-control text-end money-input"
                               value="@Model.SalePrice.ToString("N0")">
                    </div>
                    @* THÔNG BÁO LỖI HIỂN THỊ DƯỚI THANH GIÁ *@
                    <div class="col-sm-4"></div>
                    <div class="col-sm-8">
                        <span id="price-error-msg" class="text-danger" style="display:none; font-size: 0.8rem;">
                            <i class="bi bi-x-circle"></i> Giá không được âm. Đã trả về giá cũ!
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <img src="~/images/products/@(string.IsNullOrEmpty(Model.Photo) ? "demo.png" : Model.Photo)"
                     alt="@Model.ProductName"
                     class="img-thumbnail"
                     style="max-height:150px">
            </div>
        </div>

        <div class="modal-footer px-0 pb-0">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Cập nhật
            </button>
            <button type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                Đóng
            </button>
        </div>
    </form>
</div>

<script>
    (function ($) {
        // Namespace .SataAction giúp định danh chính xác sự kiện của mình
        var eventName = "submit.SataAction";
        $(document).off(eventName, "#formUpdateOrderDetail, #formUpdateCartItem");

        $(document).on(eventName, "#formUpdateOrderDetail, #formUpdateCartItem", function (e) {
            // Chặn tuyệt đối
            e.preventDefault();
            e.stopImmediatePropagation();

            let form = $(this);
            let btn = form.find("button[type='submit']");
            let isDBUpdate = form.attr("id") === "formUpdateOrderDetail";

            // Xử lý giá tiền (loại bỏ dấu chấm phân cách nghìn)
            let rawPrice = form.find("input[name='SalePrice']").val() || "0";
            let cleanPrice = rawPrice.toString().replace(/\./g, '').replace(/,/g, '');

            let formData = form.serializeArray();
            $.each(formData, function (i, field) {
                if (field.name === "SalePrice") field.value = cleanPrice;
            });

            btn.prop("disabled", true).text("Đang xử lý...");

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: $.param(formData),
                success: function (res) {
                    if (isDBUpdate) {
                        // Trường hợp sửa Chi tiết đơn hàng trong DB
                        if (typeof res === "object" && res.success) {
                            showToast("✅ Cập nhật Database thành công!");
                            $("#dialogModal").modal("hide");
                            // Đợi 1 chút rồi reload để cập nhật lại tổng tiền trên giao diện chính
                            setTimeout(() => { location.reload(); }, 600);
                        } else {
                            showToast("❌ " + (res.message || "Lỗi cập nhật"), true);
                        }
                    } else {
                        // Trường hợp đang lập đơn hàng (Sửa giỏ hàng tạm)
                        $("#showCart").html(res);
                        $("#dialogModal").modal("hide");
                        showToast("✅ Đã cập nhật giỏ hàng!");
                    }
                },
                error: function () {
                    showToast("❌ Lỗi kết nối Server!", true);
                },
                complete: function () {
                    btn.prop("disabled", false).text("Cập nhật");
                }
            });

            return false;
        });
    })(jQuery);
</script>