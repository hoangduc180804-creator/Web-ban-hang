@model dynamic
@{
    Layout = null;

    // Kiểm tra xem đây là Đơn hàng trong DB hay Giỏ hàng trong Session
    bool isOrderDetail = false;
    try
    {
        // Nếu có thuộc tính OrderID và nó khác 0 thì là Đơn hàng trong DB
        isOrderDetail = Model.OrderID > 0;
    }
    catch { }

    // Xác định Action để gửi dữ liệu
    string actionUrl = isOrderDetail ? "~/Order/UpdateDetail" : "~/Order/AddToCart";
    string formId = isOrderDetail ? "formUpdateOrderDetail" : "formUpdateCartItem";
}

<div class="modal-header">
    <strong class="modal-title">
        <i class="bi bi-pencil-square"></i> Cập nhật chi tiết đơn hàng
    </strong>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
    <form id="@formId" action="@Url.Content(actionUrl)" method="post" class="container-fluid">
        @* Các hidden input để giữ thông tin định danh *@
        @if (isOrderDetail)
        {
            <input type="hidden" name="OrderID" value="@Model.OrderID" />
        }
        <input type="hidden" name="ProductID" value="@Model.ProductID" />
        <input type="hidden" name="ProductName" value="@Model.ProductName" />
        <input type="hidden" name="Unit" value="@Model.Unit" />
        <input type="hidden" name="Photo" value="@Model.Photo" />

        <div class="row">
            <div class="col-md-8">
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 col-form-label fw-semibold">Mặt hàng</label>
                    <div class="col-sm-8">
                        <input type="text"
                               class="form-control-plaintext fw-bold text-primary"
                               value="@Model.ProductName"
                               readonly>
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 col-form-label fw-semibold">Số lượng</label>
                    <div class="col-sm-5">
                        <input type="number"
                               name="Quantity"
                               class="form-control text-end"
                               min="1"
                               value="@Model.Quantity">
                    </div>
                </div>
                <div class="row mb-3 align-items-center">
                    <label class="col-sm-4 col-form-label fw-semibold">Đơn giá</label>
                    <div class="col-sm-5">
                        <input type="text"
                               name="SalePrice"
                               class="form-control text-end money-input"
                               value="@Model.SalePrice.ToString("N0")">
                    </div>
                    @* THÔNG BÁO LỖI HIỂN THỊ DƯỚI THANH GIÁ *@
                    <div class="col-sm-4"></div>
                    <div class="col-sm-8">
                        <span id="price-error-msg" class="text-danger" style="display:none; font-size: 0.8rem;">
                            <i class="bi bi-x-circle"></i> Giá không được âm. Đã trả về giá cũ!
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-end">
                <img src="~/images/products/@(string.IsNullOrEmpty(Model.Photo) ? "demo.png" : Model.Photo)"
                     alt="@Model.ProductName"
                     class="img-thumbnail"
                     style="max-height:150px">
            </div>
        </div>

        <div class="modal-footer px-0 pb-0">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Cập nhật
            </button>
            <button type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                Đóng
            </button>
        </div>
    </form>
</div>

<script>
    (function () {

        // =============================
        // CHẶN SUBMIT MẶC ĐỊNH + AJAX
        // =============================
        $(document).on("submit", "#formUpdateOrderDetail, #formUpdateCartItem", function (e) {

            e.preventDefault();
            e.stopImmediatePropagation(); // 🔥 chặn tất cả submit khác

            let form = $(this);
            let actionUrl = form.attr("action");
            let methodType = form.attr("method") || "POST";

            // =============================
            // LẤY GIÁ TRỊ GIÁ (XỬ LÝ FORMAT)
            // =============================
            let priceInput = form.find("input[name='SalePrice']");
            let rawPrice = priceInput.val() || "0";

            let cleanPrice = parseFloat(
                rawPrice.toString().replace(/\./g, '').replace(/,/g, '')
            ) || 0;

            // Validate
            if (cleanPrice < 0) {
                showToast("❌ Giá không được âm!", true);
                return false;
            }

            // =============================
            // CHUẨN BỊ DATA
            // =============================
            let formData = form.serializeArray();

            $.each(formData, function (i, field) {
                if (field.name === "SalePrice") {
                    field.value = cleanPrice;
                }
            });

            // =============================
            // HIỆN LOADING (OPTIONAL)
            // =============================
            let btn = form.find("button[type='submit']");
            btn.prop("disabled", true).text("Đang xử lý...");

            // =============================
            // AJAX
            // =============================
            $.ajax({
                url: actionUrl,
                type: methodType,
                data: $.param(formData),

                success: function (res) {

                    // =============================
                    // TRƯỜNG HỢP JSON
                    // =============================
                    if (res && typeof res === "object" && res.success !== undefined) {

                        if (res.success === true) {
                            showToast("✅ Cập nhật thành công!");

                            if (form.attr("id") === "formUpdateOrderDetail") {
                                setTimeout(() => location.reload(), 800);
                            } else {
                                $("#dialogModal").modal("hide");
                            }
                        } else {
                            showToast("❌ " + (res.message || "Cập nhật thất bại"), true);
                        }
                    }

                    // =============================
                    // TRƯỜNG HỢP HTML (GIỎ HÀNG)
                    // =============================
                    else if (typeof res === "string") {
                        $("#showCart").html(res);
                        $("#dialogModal").modal("hide");
                        showToast("✅ Cập nhật thành công!");
                    }

                    // =============================
                    // KHÔNG XÁC ĐỊNH
                    // =============================
                    else {
                        showToast("❌ Phản hồi không hợp lệ!", true);
                    }
                },

                error: function () {
                    showToast("❌ Lỗi kết nối server!", true);
                },

                complete: function () {
                    btn.prop("disabled", false).text("Cập nhật");
                }
            });

            return false;
        });


        // =============================
        // TOAST THÔNG BÁO
        // =============================
        function showToast(message, isError) {

            let bg = isError ? "bg-danger" : "bg-success";

            let toast = $(`
                <div class="toast align-items-center text-white ${bg} border-0 position-fixed top-0 end-0 m-3"
                     role="alert" style="z-index:9999;">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `);

            $("body").append(toast);

            let bsToast = new bootstrap.Toast(toast[0], { delay: 2000 });
            bsToast.show();

            toast.on("hidden.bs.toast", function () {
                toast.remove();
            });
        }

    })();
</script>