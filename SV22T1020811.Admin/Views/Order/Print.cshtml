@model SV22T1020811.Models.Sales.OrderDetailModel
@{
    Layout = null;
    int stt = 1;
    decimal total = 0;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hóa đơn #@Model.Order.OrderID</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Thiết lập cho PDF */
        @@page {
            size: A4;
            margin: 0; 
        }

        body {
            font-family: 'Inter', Arial, sans-serif; /* Thêm font dự phòng nếu mạng chậm */
            background-color: #ffffff;
            margin: 0;
            padding: 0;
            color: #1d1e20;
            font-size: 15px; /* TĂNG CỠ CHỮ TỔNG THỂ */
            line-height: 1.6; /* Tăng khoảng cách giữa các dòng */
        }

        .document-page {
            width: 100%;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* --- HEADER --- */
        .header-section {
            background-color: #f2f3f5;
            padding: 40px 50px; /* Tăng độ rộng của header */
        }
        .header-table {
            width: 100%;
            border-collapse: collapse;
        }
        .brand-name {
            font-size: 24px; /* Tên logo to hơn */
            font-weight: 700;
            color: #2a3d66;
            text-transform: uppercase;
            letter-spacing: 1px;
            vertical-align: middle;
            padding-left: 20px;
        }
        .website-text {
            font-size: 15px;
            color: #2a3d66;
            font-weight: 500;
            text-align: right;
            vertical-align: middle;
        }

        /* --- MAIN CONTENT --- */
        .main-content {
            padding: 50px 50px 20px 50px; /* Lùi lề vào trong cho cân đối */
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 60px; /* Tăng khoảng cách xuống bảng */
        }
        .customer-info h3 {
            font-size: 18px; /* Tên khách hàng to và rõ nét hơn */
            text-transform: uppercase;
            font-weight: 700;
            margin: 0 0 8px 0;
            color: #2a3d66;
        }
        .customer-info p {
            margin: 5px 0;
            color: #5e6065;
            font-size: 15px;
        }

        .invoice-title {
            font-size: 46px; /* Chữ HÓA ĐƠN to giống hệt bản gốc */
            font-weight: 700;
            color: #d15c42;
            margin: 0 0 10px 0;
            letter-spacing: 1.5px;
            text-align: right;
            line-height: 1;
        }
        .invoice-meta {
            font-size: 15px;
            color: #5e6065;
            margin: 5px 0;
            text-align: right;
        }

        /* --- TABLE --- */
        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 40px;
        }
        .items-table th {
            text-align: left;
            padding: 15px 5px; /* Giãn cách tiêu đề bảng */
            border-top: 1px solid #2b2b2b;
            border-bottom: 1px solid #2b2b2b;
            font-size: 14px;
            font-weight: 700;
            color: #000;
        }
        .items-table td {
            padding: 22px 5px; /* Tăng khoảng cách giữa các món hàng cho thoáng */
            border-bottom: 1px solid #eaeaea;
            color: #5e6065;
            font-size: 15px;
        }

        /* --- TOTALS --- */
        .totals-container {
            width: 100%;
        }
        .totals-table {
            width: 320px;
            border-collapse: collapse;
            float: right;
        }
        .totals-table td {
            padding: 8px 0; /* Giãn cách các dòng tổng tiền */
            text-align: right;
            color: #5e6065;
            font-size: 15px;
        }
        .totals-table .grand-total-label,
        .totals-table .grand-total-value {
            font-weight: 700;
            color: #2a3d66;
            font-size: 18px; /* Nhấn mạnh tổng tiền */
            padding-top: 15px;
            border-top: 1px solid #2b2b2b;
        }
        .clearfix::after {
            content: "";
            clear: both;
            display: table;
        }

        /* --- FOOTER --- */
        .footer-section {
            margin-top: 80px; 
            padding: 10px 40px 10px 38px;
            /* Dùng border-left để tạo vạch cam thay vì position absolute -> Chuẩn 100% trên PDF */
            border-left: 12px solid #d15c42; 
        }
        .footer-table {
            width: 100%;
            border-collapse: collapse;
        }
        .footer-title {
            font-size: 14px;
            font-weight: 700;
            color: #2a3d66;
            margin-bottom: 12px;
            text-transform: uppercase;
        }
        .footer-text {
            font-size: 14px;
            color: #5e6065;
            line-height: 1.8; /* Dãn dòng cho chữ dễ nhìn */
        }
        
        .text-center { text-align: center; }
        .text-right { text-align: right; }
    </style>
</head>
<body>
    <div class="document-page">
        
        <div class="header-section">
            <table class="header-table">
                <tr>
                    <td style="width: 55px;">
                        <svg width="55" height="55" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="20" y="45" width="40" height="35" stroke="#2a3d66" stroke-width="5" fill="none"/>
                            <rect x="50" y="20" width="30" height="30" stroke="#2a3d66" stroke-width="5" fill="none"/>
                            <line x1="10" y1="80" x2="90" y2="80" stroke="#2a3d66" stroke-width="5"/>
                        </svg>
                    </td>
                    <td class="brand-name">
                        SATA STEEL
                    </td>
                    <td class="website-text">
                        Hệ thống quản lý trực tuyến
                    </td>
                </tr>
            </table>
        </div>

        <div class="main-content">
            <table class="info-table">
                <tr>
                    <td style="vertical-align: top; width: 50%;">
                        <div class="customer-info">
                            <h3>@Model.Order.CustomerName</h3>
                            <p>@Model.Order.CustomerPhone</p>
                            <p>@Model.Order.CustomerAddress</p>
                        </div>
                    </td>
                    <td style="vertical-align: top; width: 50%;">
                        <div class="invoice-title">HÓA ĐƠN</div>
                        <div class="invoice-meta">Hóa đơn #@Model.Order.OrderID</div>
                        <div class="invoice-meta">Ngày @Model.Order.OrderTime.ToString("dd/MM/yyyy")</div>
                    </td>
                </tr>
            </table>

            <table class="items-table">
                <thead>
                    <tr>
                        <th style="width: 5%;">Mục</th>
                        <th style="width: 40%;">Tên sản phẩm</th>
                        <th style="width: 10%;" class="text-center">ĐVT</th>
                        <th style="width: 15%;" class="text-center">Số lượng</th>
                        <th style="width: 15%;" class="text-right">Đơn giá</th>
                        <th style="width: 15%;" class="text-right">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Details)
                    {
                        var thanhTien = item.Quantity * item.SalePrice;
                        total += thanhTien;
                        <tr>
                            <td>@(stt++)</td>
                            <td style="color: #1d1e20;">@item.ProductName</td>
                            <td class="text-center">@item.Unit</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-right">@item.SalePrice.ToString("N0")đ</td>
                            <td class="text-right" style="color: #1d1e20;">@thanhTien.ToString("N0")đ</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="totals-container clearfix">
                <table class="totals-table">
                    <tr>
                        <td>Tổng cộng:</td>
                        <td>@total.ToString("N0")đ</td>
                    </tr>
                    <tr>
                        <td>Thuế (0%):</td>
                        <td>0đ</td>
                    </tr>
                    <tr>
                        <td class="grand-total-label">TỔNG TIỀN:</td>
                        <td class="grand-total-value">@total.ToString("N0")Đ</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="footer-section">
            <table class="footer-table">
                <tr>
                    <td style="vertical-align: top; width: 50%;">
                        <div class="footer-title">THÔNG TIN GIAO DỊCH</div>
                        <div class="footer-text">
                            Nhân viên lập: @Model.Order.EmployeeName<br />
                            Trạng thái đơn: @Model.Order.Status.GetDescription()<br />
                            Ngày in: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </td>
                    <td style="vertical-align: top; width: 50%;">
                        <div class="footer-title">XÁC NHẬN CỦA KHÁCH HÀNG</div>
                        <div class="footer-text">
                            <br /><br /><br />
                            (Ký và ghi rõ họ tên)
                        </div>
                    </td>
                </tr>
            </table>
        </div>

    </div>
</body>
</html>