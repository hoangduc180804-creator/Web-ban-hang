@model int
@{
    Layout = null;
}
@* Form gửi dữ liệu về Action Delete với phương thức POST *@
<form action="~/Order/Delete/@Model" method="post" id="formDelete">
    <div class="modal-header text-bg-danger">
        <strong class="modal-title">
            <i class="bi bi-trash me-2"></i>Xóa đơn hàng
        </strong>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div class="alert alert-danger d-flex align-items-center">
            <i class="bi bi-info-circle me-2 fs-4"></i>
            <div>
                Bạn có chắc chắn muốn <strong>xóa vĩnh viễn</strong> đơn hàng này không?
            </div>
        </div>
        <p class="text-muted small mb-0 text-center">Lưu ý: Dữ liệu đơn hàng và chi tiết các mặt hàng sẽ bị xóa khỏi hệ thống.</p>
    </div>

    <div class="modal-footer">
        @* Nút submit kích hoạt hành động xóa thông qua formDelete *@
        <button type="submit" form="formDelete" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i> Chấp nhận
        </button>
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Đóng
        </button>
    </div>
</form>