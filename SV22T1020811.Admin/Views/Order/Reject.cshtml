@model int
@{
    Layout = null;
}
@* Form gửi dữ liệu về Action Reject với phương thức POST *@
<form action="~/Order/Reject/@Model" method="post" id="formReject">
    <div class="modal-header text-bg-danger">
        <strong class="modal-title">
            <i class="bi bi-x-circle me-2"></i>Xác nhận từ chối đơn hàng
        </strong>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div class="alert alert-danger d-flex align-items-center">
            <i class="bi bi-info-circle me-2 fs-4"></i>
            <div>
                Bạn có thực sự muốn <strong>từ chối</strong> đơn hàng này hay không?
            </div>
        </div>
        <p class="text-muted small mb-0">Trạng thái đơn hàng sẽ được chuyển thành "Bị từ chối".</p>
    </div>

    <div class="modal-footer">
        @* Nút submit liên kết với formReject thông qua ID *@
        <button type="submit" form="formReject" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i> Chấp nhận
        </button>
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Đóng
        </button>
    </div>
</form>