@model int
@{
    Layout = null;
}
@* Form gửi dữ liệu về Action Finish với phương thức POST *@
<form action="~/Order/Finish/@Model" method="post" id="formFinish">
    <div class="modal-header text-bg-success">
        <strong class="modal-title">
            <i class="bi bi-check-circle me-2"></i>Xác nhận đơn hàng thành công
        </strong>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <div class="modal-body">
        <div class="alert alert-success d-flex align-items-center">
            <i class="bi bi-info-circle me-2"></i>
            <div>
                Bạn có chắc chắn xác nhận đơn hàng này đã được <strong>giao thành công</strong>?
            </div>
        </div>
    </div>

    <div class="modal-footer">
        @* Nút submit liên kết với formFinish *@
        <button type="submit" form="formFinish" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i> Chấp nhận
        </button>
        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Đóng
        </button>
    </div>
</form>