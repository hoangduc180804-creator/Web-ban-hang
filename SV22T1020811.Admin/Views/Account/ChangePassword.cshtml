@{
    ViewBag.Title = "Thay đổi mật khẩu";
    // Lấy tên hiện tại từ Claims để hiển thị vào ô nhập
    var currentDisplayName = User.FindFirst("DisplayName")?.Value ?? "";
}

<div class="row justify-content-center">
    <div class="col-12">
        @* 1. Cấu hình action gửi về AccountController *@
        <form action="~/Account/ChangePassword" method="post">

            @* 2. Token bảo mật *@
            @Html.AntiForgeryToken()

            <div class="card card-warning card-outline">
                <div class="card-body">

                    @* 3. Hiển thị thông báo lỗi hoặc thành công *@
                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle"></i> @ViewBag.Message
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    <div class="text-danger mb-3">
                        @Html.ValidationSummary(true)
                    </div>

                    @* THÊM PHẦN HIỂN THỊ VÀ ĐỔI FULLNAME Ở ĐÂY *@
                    <div class="mb-3">
                        <label class="form-label">Họ và tên hiển thị</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person-badge-fill"></i>
                            </span>
                            <input type="text" name="fullName" class="form-control"
                                   value="@currentDisplayName" placeholder="Nhập họ tên mới" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu cũ</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            @* Thêm name="oldPassword" *@
                            <input type="password" name="oldPassword" class="form-control" placeholder="Nhập mật khẩu cũ" autofocus required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-shield-lock-fill"></i>
                            </span>
                            @* Thêm name="newPassword" *@
                            <input type="password" name="newPassword" class="form-control" placeholder="Nhập mật khẩu mới" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-check-circle-fill"></i>
                            </span>
                            @* Thêm name="confirmPassword" *@
                            <input type="password" name="confirmPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" required>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Cập nhật thông tin
                    </button>
                    <a href="~/" class="btn btn-secondary me-2">
                        <i class="bi bi-back"></i> Quay lại
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>