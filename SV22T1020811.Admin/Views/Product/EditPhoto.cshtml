@model SV22T1020811.Models.Catalog.ProductPhoto
@{
}
@section PageToolBar {
    <button type="submit" form="formEdit" class="btn btn-primary">
        <i class="bi bi-save"></i>
        Lưu ảnh
    </button>

    <a href="~/Product/Edit/@Model.ProductID#photos" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}
<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-outline card-info">
            <div class="card-header">
                <h5 class="mb-0">@ViewBag.Title</h5>
            </div>

            <div class="card-body">
                @* Cần enctype="multipart/form-data" để upload file *@
                <form id="formEdit" action="~/Product/SavePhoto" method="post" enctype="multipart/form-data">

                    @* Các trường ẩn để định danh đối tượng *@
                    <input type="hidden" name="@nameof(Model.PhotoID)" value="@Model.PhotoID" />
                    <input type="hidden" name="@nameof(Model.ProductID)" value="@Model.ProductID" />
                    <input type="hidden" name="@nameof(Model.Photo)" value="@Model.Photo" />

                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-3 fw-semibold">Chọn ảnh</label>
                        <div class="col-sm-9">
                            @* name="uploadPhoto" phải khớp với tham số trong Controller *@
                            <input type="file"
                                   name="uploadPhoto"
                                   class="form-control"
                                   accept="image/*"
                                   onchange="document.getElementById('imgPreview').src = window.URL.createObjectURL(this.files[0])" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 fw-semibold">Xem trước</label>
                        <div class="col-sm-9">
                            <img id="imgPreview"
                                 src="~/images/products/@(string.IsNullOrEmpty(Model.Photo) ? "nophoto.png" : Model.Photo)"
                                 class="img-thumbnail"
                                 style="max-height:200px;"
                                 onerror="this.src='/images/products/nophoto.png'" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 fw-semibold">Mô tả / Tiêu đề</label>
                        <div class="col-sm-9">
                            <input type="text" name="Description"
                                   value="@Model.Description"
                                   class="form-control"
                                   placeholder="Nhập mô tả ngắn cho ảnh" />
                            @* Thêm dòng này để hiện thông báo "Vui lòng nhập mô tả..." *@
                            @Html.ValidationMessage(nameof(Model.Description), "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-3 fw-semibold">Thứ tự hiển thị</label>
                        <div class="col-sm-3">
                            <input type="number"
                                   name="@nameof(Model.DisplayOrder)"
                                   class="form-control"
                                   value="@Model.DisplayOrder"
                                   min="1" />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-sm-3 fw-semibold">Trạng thái</label>
                        <div class="col-sm-9">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="@nameof(Model.IsHidden)"
                                       value="true"
                                       id="IsHidden" @(Model.IsHidden ? "checked" : "") />
                                <label class="form-check-label" for="IsHidden">
                                    Ẩn ảnh này (không hiển thị cho khách hàng)
                                </label>
                                @* Trường ẩn để xử lý giá trị false của checkbox trong ASP.NET MVC *@
                                <input type="hidden" name="@nameof(Model.IsHidden)" value="false" />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hàm hỗ trợ xem trước ảnh khi chọn từ máy tính
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#imgPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}