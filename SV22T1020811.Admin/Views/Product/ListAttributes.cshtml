@model int
@{
    Layout = null;
    // Gọi Service lấy danh sách thuộc tính của mặt hàng dựa vào Model (ProductID)
    var attributes = await SV22T1020811.BusinessLayers.CatalogDataService.ListAttributesAsync(Model);
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-success card-outline mt-4">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h6 id="attributes" class="card-title mb-0">
                            <i class="bi bi-list-check me-2"></i>
                            Thuộc tính mặt hàng
                        </h6>
                    </div>
                    <div class="col text-end">
                        <a class="btn btn-sm btn-primary" href="~/Product/CreateAttribute/@Model">
                            <i class="bi bi-plus-circle me-1"></i>
                            Thêm thuộc tính
                        </a>
                    </div>
                </div>
            </div>

            <div class="card-body p-1">
                <table class="table table-bordered table-hover mb-0">
                    <thead class="table-secondary">
                        <tr>
                            <th>Tên thuộc tính</th>
                            <th>Giá trị</th>
                            <th style="width:120px" class="text-center">Thứ tự</th>
                            <th style="width:100px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (attributes != null && attributes.Any())
                        {
                            foreach (var item in attributes)
                            {
                                <tr>
                                    <td class="align-middle"><strong>@item.AttributeName</strong></td>
                                    <td class="align-middle">@item.AttributeValue</td>
                                    <td class="text-center align-middle">@item.DisplayOrder</td>
                                    <td class="text-center text-nowrap align-middle">
                                        @* Nút Sửa: Truyền ProductID qua path và AttributeID qua QueryString *@
                                        <a class="btn btn-sm btn-info"
                                           href="~/Product/EditAttribute/@Model?attributeId=@item.AttributeID"
                                           title="Sửa thuộc tính">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        @* Nút Xóa: Xác nhận trước khi xóa *@
                                        <a class="btn btn-sm btn-danger"
                                           href="~/Product/DeleteAttribute/@Model?attributeId=@item.AttributeID"
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa thuộc tính này?')"
                                           title="Xóa thuộc tính">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Mặt hàng này hiện chưa có thông số kỹ thuật hoặc thuộc tính nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>