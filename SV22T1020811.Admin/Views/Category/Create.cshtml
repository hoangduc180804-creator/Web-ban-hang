<div class="card card-primary mt-3">
    <div class="card-header"><h3 class="card-title">@ViewBag.Title</h3></div>
    <form action="~/Category/Save" method="post">
        <div class="card-body">
            <div class="mb-3">
                <label class="fw-bold">Tên loại hàng:</label>
                <input type="text" class="form-control" name="CategoryName" autofocus>
            </div>
            <div class="mb-3">
                <label class="fw-bold">Mô tả:</label>
                <textarea class="form-control" name="Description" rows="3"></textarea>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Lưu dữ liệu</button>
            <a href="~/Category" class="btn btn-default">Quay lại</a>
        </div>
    </form>
</div>