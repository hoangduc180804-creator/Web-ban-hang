@model SV22T1020811.Models.Catalog.Category
@{
    ViewBag.Title = "Xóa loại hàng";
}

@section PageToolBar {
    @* Nếu không có lỗi hệ thống thì mới hiện nút Xóa *@
    @if (TempData["ErrorMessage"] == null)
    {
        <button type="submit" form="formDelete" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i>
            Xóa
        </button>
    }
    <a href="~/Category" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-danger card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Xác nhận xóa loại hàng
                </h5>
            </div>

            <div class="card-body">
                @* Hiển thị thông báo lỗi từ Controller nếu xóa thất bại *@
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-x-circle me-2"></i>
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form id="formDelete" action="~/Category/Delete/@Model.CategoryID" method="post">
                    <div class="alert alert-warning d-flex align-items-center">
                        <i class="bi bi-info-circle me-2"></i>
                        Bạn có chắc chắn muốn xóa loại hàng sau không?
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-3">Tên loại hàng</dt>
                        <dd class="col-sm-9 fw-bold text-primary">@Model.CategoryName</dd>

                        <dt class="col-sm-3">Mô tả</dt>
                        <dd class="col-sm-9">
                            @(string.IsNullOrEmpty(Model.Description) ? "(Không có mô tả)" : Model.Description)
                        </dd>
                    </dl>
                </form>
            </div>
        </div>
    </div>
</div>