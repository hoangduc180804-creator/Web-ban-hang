@using SV22T1020811.Models.Partner
@{
    ViewBag.Title = "Mật khẩu khách hàng";
    // Lấy dữ liệu khách hàng từ ViewBag truyền sang
    var customer = ViewBag.Customer as Customer;
}

@section PageToolBar {
    <button type="submit" form="formChangePassword" class="btn btn-primary">
        <i class="bi bi-key me-1"></i>
        Đổi mật khẩu
    </button>
    <a href="~/Customer" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-warning card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-shield-lock me-2"></i>
                    Đổi mật khẩu khách hàng
                </h5>
            </div>

            <div class="card-body">
                @* Bổ sung thuộc tính action để gửi về đúng hàm POST *@
                <form id="formChangePassword" method="post" action="~/Customer/ChangePassword">
                    @* Input ẩn để gửi ID khách hàng lên *@
                    <input type="hidden" name="id" value="@customer?.CustomerID" />

                    <fieldset class="mb-4">
                        <legend class="fs-6 text-muted mb-3">
                            <i class="bi bi-person me-1"></i>
                            Thông tin khách hàng
                        </legend>

                        <dl class="row mb-0">
                            <dt class="col-sm-3">Tên khách hàng</dt>
                            <dd class="col-sm-9">@customer?.CustomerName</dd>

                            <dt class="col-sm-3">Email</dt>
                            <dd class="col-sm-9">@customer?.Email</dd>

                            <dt class="col-sm-3">Trạng thái</dt>
                            <dd class="col-sm-9">
                                @if (customer != null && customer.IsActive)
                                {
                                    <span class="badge bg-success">Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Bị khóa</span>
                                }
                            </dd>
                        </dl>
                    </fieldset>

                    <fieldset>
                        <legend class="fs-6 text-muted mb-3">
                            <i class="bi bi-key me-1"></i>
                            Thông tin mật khẩu
                        </legend>

                        @* Hiển thị thông báo lỗi nếu có *@
                        <div class="text-danger mb-2">@Html.ValidationSummary(true)</div>

                        <div class="mb-3">
                            <label class="form-label">Mật khẩu mới</label>
                            <input type="password"
                                   name="newPassword"
                                   class="form-control"
                                   placeholder="Nhập mật khẩu mới" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Xác nhận mật khẩu</label>
                            <input type="password"
                                   name="confirmPassword"
                                   class="form-control"
                                   placeholder="Nhập lại mật khẩu mới" required />
                        </div>

                    </fieldset>

                </form>
            </div>
        </div>
    </div>
</div>