@using SV22T1020811.Models.Sales
@{
    ViewBag.Title = "Bảng điều khiển - LiteCommerce";
    var recentOrders = ViewBag.RecentOrders as List<OrderViewInfo> ?? new List<OrderViewInfo>();
}

<div class="row">
    <div class="col-lg-3 col-6">
        <div class="card text-bg-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Doanh thu tạm tính</h6>
                        <h3 class="mb-0">@string.Format("{0:N0}", ViewBag.TotalRevenue ?? 0) đ</h3>
                    </div>
                    <i class="bi bi-currency-dollar fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="card text-bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Đơn hàng</h6>
                        <h3 class="mb-0">@string.Format("{0:N0}", ViewBag.OrderCount ?? 0)</h3>
                    </div>
                    <i class="bi bi-receipt fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="card text-bg-warning">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Khách hàng</h6>
                        <h3 class="mb-0">@string.Format("{0:N0}", ViewBag.CustomerCount ?? 0)</h3>
                    </div>
                    <i class="bi bi-people fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-6">
        <div class="card text-bg-danger">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="card-title">Sản phẩm</h6>
                        <h3 class="mb-0">@string.Format("{0:N0}", ViewBag.ProductCount ?? 0)</h3>
                    </div>
                    <i class="bi bi-box-seam fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-lg-8">
        <div class="card card-success card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-bar-chart me-1"></i>
                    Doanh thu theo tháng
                </h5>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="150"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card card-info card-outline">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-star me-1"></i>
                    Top sản phẩm bán chạy
                </h5>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @* Tạm thời giữ dữ liệu mẫu, Đức có thể truyền thêm ViewBag.TopProducts nếu muốn *@
                    <li class="list-group-item d-flex justify-content-between">
                        Laptop Dell
                        <span class="badge bg-success">120</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        iPhone 15
                        <span class="badge bg-success">98</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        Tai nghe Sony
                        <span class="badge bg-success">76</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        Chuột Logitech
                        <span class="badge bg-success">65</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card card-primary card-outline">
            <div class="card-header text-bg-light">
                <h5 class="card-title mb-0">
                    <i class="bi bi-clock-history me-1"></i>
                    Đơn hàng mới nhất
                </h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày</th>
                            <th class="text-end">Tổng tiền</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentOrders.Count > 0)
                        {
                            foreach (var item in recentOrders)
                            {
                                <tr>
                                    <td>#@item.OrderID</td>
                                    <td>@item.CustomerName</td>
                                    <td>@item.OrderTime.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@string.Format("{0:N0}", item.SumOrderTotal) đ</td>
                                    <td>
                                        @{
                                            string statusName = "";
                                            string badgeClass = "";

                                            switch ((int)item.Status)
                                            {
                                                case 1: statusName = "Chờ duyệt"; badgeClass = "bg-danger"; break;
                                                case 2: statusName = "Chờ giao hàng"; badgeClass = "bg-primary"; break;
                                                case 3: statusName = "Đang giao hàng"; badgeClass = "bg-warning text-dark"; break;
                                                case 4: statusName = "Đã hoàn tất"; badgeClass = "bg-success"; break;
                                                case -1: statusName = "Đã hủy"; badgeClass = "bg-secondary"; break;
                                                case -2: statusName = "Bị từ chối"; badgeClass = "bg-dark"; break;
                                                default: statusName = "Không xác định"; badgeClass = "bg-light text-dark"; break;
                                            }
                                        }
                                        <span class="badge @badgeClass">@statusName</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center p-3 text-muted">Chưa có dữ liệu đơn hàng.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('revenueChart');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6'],
                datasets: [{
                    label: 'Doanh thu (triệu đồng)',
                    data: [120, 150, 180, 140, 200, 220],
                    backgroundColor: 'rgba(13,110,253,0.7)',
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: true, position: 'top' },
                    tooltip: {
                        callbacks: {
                            label: function (context) { return context.raw + ' triệu đồng'; }
                        }
                    }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    </script>
}